JWT_SECRET=SuperSecretKeyForMesaAyudaIA2026OfimaTechLead!
JWT_ISSUER=MesaAyuda.Api
JWT_AUDIENCE=MesaAyuda.Client

# =============================================================================
# Servicio RAG y Proveedor LLM
# =============================================================================
RAG_SERVICE_URL=http://rag-service:8000
# Proveedor activo: mock | gemini | openai
