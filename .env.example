# =============================================================================
# Base de Datos PostgreSQL (Docker Compose & .NET 8 Infrastructure)
# =============================================================================
POSTGRES_DB=mesaayuda
POSTGRES_USER=mesaayuda_user
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_DEV_PASSWORD

# =============================================================================
# Autenticación JWT y Política de Sesión (.NET 8 API)
# =============================================================================
JWT_SECRET=CHANGE_ME_LOCAL_DEV_JWT_SECRET_AT_LEAST_32_CHARS
JWT_ISSUER=MesaAyuda.Api
JWT_AUDIENCE=MesaAyuda.Client

# =============================================================================
# Microservicio RAG y Proveedores LLM (Python 3.11 / FastAPI)
# =============================================================================
RAG_SERVICE_URL=http://rag-service:8000
# Proveedor activo: mock | gemini | openai (fallback automático a mock)
LLM_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=

# =============================================================================
# Almacén Vectorial ChromaDB, Embeddings y Chunking
# =============================================================================
CORPUS_PATH=/app/corpus
CHROMA_PERSIST_DIR=/tmp/chroma_data
COLLECTION_NAME=manuales_erp
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=650
CHUNK_OVERLAP=120
SIMILARITY_THRESHOLD=0.35
